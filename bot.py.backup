        keyboard = []

        for withdrawal in withdrawals:
            withdrawal_id = withdrawal[0]
            status = withdrawal[5]

            text += (
                f"ID: {withdrawal_id}\n"
                f"User: {withdrawal[1]}\n"
                f"Amount: ₦{withdrawal[2]:,.2f}\n"
                f"Fee: ₦{withdrawal[3]:,.2f}\n"
                f"Net: ₦{withdrawal[4]:,.2f}\n"
                f"Status: {status}\n"
                f"Date: {withdrawal[6]}\n"
                "────────────\n"
