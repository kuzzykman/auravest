async def automatic_amount(update, context):

    if not update.message:
        return

    try:
        amount = float(update.message.text.replace(",", ""))

    except ValueError:
        await update.message.reply_text(
            "❌ Enter a valid amount.\nExample: 5000"
        )
        return

    if amount <= 0:
        await update.message.reply_text(
            "❌ Amount must be greater than zero."
        )
        return

    user_id = update.effective_user.id

    link, tx_ref = await create_flutterwave_payment(
        user_id,
        amount
    )

    if not link:
        await update.message.reply_text(
            "❌ Unable to create payment right now.\n"
            "Please try again or use Manual Deposit."
        )
        return

    conn = db()
    cur = conn.cursor()

    cur.execute("""
        INSERT INTO transactions
        (user_id, tx_ref, amount, type, status, created_at)
        VALUES (?, ?, ?, ?, ?, ?)
    """, (
        user_id,
        tx_ref,
        amount,
        "automatic_deposit",
        "pending",
        datetime.now().isoformat()
    ))

    conn.commit()
    conn.close()

    keyboard = [
        [
            InlineKeyboardButton(
                "💳 Pay Now",
                url=link
            )
        ],
        [
            InlineKeyboardButton(
                "⬅️ Back",
                callback_data="deposit"
            )
        ],
    ]

    await update.message.reply_text(
        f"💳 Deposit Amount: ₦{amount:,.2f}\n\n"
        "Click Pay Now to continue.\n\n"
        "Your balance will only be credited after successful "
        "payment verification.",
        reply_markup=InlineKeyboardMarkup(keyboard)
    )


