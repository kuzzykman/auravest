# =========================================================
# AUTOMATIC DEPOSIT
# =========================================================

async def create_flutterwave_payment(user_id, amount):
    tx_ref = f"AURAVEST-{user_id}-{uuid.uuid4().hex[:10]}"

    url = "https://api.flutterwave.com/v3/payments"

    headers = {
        "Authorization": f"Bearer {FLW_SECRET_KEY}",
        "Content-Type": "application/json",
    }

    payload = {
        "tx_ref": tx_ref,
        "amount": amount,
        "currency": "NGN",
        "redirect_url": "https://example.com/payment-complete",
        "customer": {
            "email": "abidekontop@gmail.com",
            "name": "AuraVest User",
        },
        "customizations": {
            "title": "AuraVest Deposit",
            "description": f"Deposit ₦{amount:,.2f}",
        },
    }

    try:
        response = requests.post(
            url,
            headers=headers,
            json=payload,
            timeout=30
        )

        print("FLUTTERWAVE STATUS:", response.status_code)
        print("FLUTTERWAVE RESPONSE:", response.text)

        data = response.json()

        if response.status_code == 200:
            link = data["data"]["link"]
            return link, tx_ref

        return None, tx_ref

    except Exception as e:
        print("FLUTTERWAVE ERROR:", e)
        return None, tx_ref

