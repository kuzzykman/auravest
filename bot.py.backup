async def withdrawal_start(query):

    user = get_user(query.from_user.id)

    balance = user[4]

    await query.edit_message_text(
        f"""
💸 WITHDRAWAL

Available Income Balance:
₦{balance:,.2f}

Minimum withdrawal: ₦{MIN_WITHDRAWAL:,}

Withdrawal fee: {WITHDRAWAL_FEE}%

Enter the amount you want to withdraw.
"""
    )


async def withdrawal_amount(update, context):

    try:
        amount = float(update.message.text.replace(",", ""))

    except ValueError:
        await update.message.reply_text(
            "❌ Enter a valid withdrawal amount."
        )
        return

    user_id = update.effective_user.id
    user = get_user(user_id)

    balance = user[4]

    if amount < MIN_WITHDRAWAL:
        await update.message.reply_text(
            f"❌ Minimum withdrawal is ₦{MIN_WITHDRAWAL:,}."
        )
        return

    if amount > balance:
        await update.message.reply_text(
            "❌ Insufficient Income Balance."
        )
        return

    fee = amount * WITHDRAWAL_FEE / 100
    net = amount - fee

    context.user_data["withdraw_amount"] = amount
    context.user_data["withdraw_fee"] = fee
    context.user_data["withdraw_net"] = net

    await update.message.reply_text(
        f"""
💸 Withdrawal Request

Amount: ₦{amount:,.2f}
Fee ({WITHDRAWAL_FEE}%): ₦{fee:,.2f}
You receive: ₦{net:,.2f}

Now send your bank details in this format:

Bank Name
Account Number
Account Name
"""
    )


async def withdrawal_details(update, context):

    if "withdraw_amount" not in context.user_data:
        return

    lines = update.message.text.split("\n")

    if len(lines) < 3:

        await update.message.reply_text(
            "❌ Please send your details exactly like this:\n\n"
            "Bank Name\n"
            "Account Number\n"
            "Account Name"
        )

        return

    bank_name = lines[0].strip()
    account_number = lines[1].strip()
    account_name = lines[2].strip()

    amount = context.user_data["withdraw_amount"]
    fee = context.user_data["withdraw_fee"]
    net = context.user_data["withdraw_net"]

    user_id = update.effective_user.id

    conn = db()
    cur = conn.cursor()

    cur.execute("""
        UPDATE users
        SET income_balance = income_balance - ?
        WHERE user_id = ?
    """, (amount, user_id))

    cur.execute("""
        INSERT INTO withdrawals
        (user_id, amount, fee, net_amount,
         bank_name, account_number, account_name,
         status, created_at)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        user_id,
        amount,
        fee,
        net,
        bank_name,
        account_number,
        account_name,
        "pending",
        datetime.now().isoformat()
    ))

    withdrawal_id = cur.lastrowid

    conn.commit()
    conn.close()

    context.user_data.clear()

    await update.message.reply_text(
        f"""
✅ Withdrawal Request Submitted

Amount: ₦{amount:,.2f}
Fee: ₦{fee:,.2f}
Net Amount: ₦{net:,.2f}

Withdrawal ID: #{withdrawal_id}

Your withdrawal is pending admin processing.
Withdrawal processing terms are shown here before submission.
""",
        reply_markup=main_menu()
    )

    await context.bot.send_message(
        chat_id=ADMIN_ID,
        text=f"""
🔔 NEW WITHDRAWAL

ID: #{withdrawal_id}
User ID: {user_id}

Amount: ₦{amount:,.2f}
Fee: ₦{fee:,.2f}
Net: ₦{net:,.2f}

Bank: {bank_name}
Account: {account_number}
Name: {account_name}
""",
        reply_markup=InlineKeyboardMarkup([
            [
                InlineKeyboardButton(
                    "✅ Approve",
                    callback_data=f"approve_withdraw_{withdrawal_id}"
                ),
                InlineKeyboardButton(
                    "❌ Reject",
                    callback_data=f"reject_withdraw_{withdrawal_id}"
                ),
            ]
        ])
    )


# =========================================================
# ADMIN DASHBOARD
# =========================================================

async def admin(update, context):

    if update.effective_user.id != ADMIN_ID:
        await update.message.reply_text(
            "❌ Admin access only."
        )
        return

    keyboard = [
        [
            InlineKeyboardButton(
                "📊 Overview",
                callback_data="admin_overview"
            )
        ],
        [
            InlineKeyboardButton(
                "💳 Pending Deposits",
                callback_data="admin_deposits"
            )
        ],
        [
            InlineKeyboardButton(
                "💸 Pending Withdrawals",
                callback_data="admin_withdrawals"
            )
        ],
        [
            InlineKeyboardButton(
                "👥 Users",
                callback_data="admin_users"
            )
        ],
    ]

    await update.message.reply_text(
        "🔐 AURAVEST ADMIN DASHBOARD",
        reply_markup=InlineKeyboardMarkup(keyboard)
    )

async def admin_overview(query):
    conn = db()
    cur = conn.cursor()

    cur.execute("SELECT COUNT(*) FROM users")
    users = cur.fetchone()[0]

    cur.execute("""
        SELECT COUNT(*)
        FROM deposits
        WHERE status = 'pending'
    """)
    pending_deposits = cur.fetchone()[0]

    cur.execute("""
        SELECT COUNT(*)
        FROM withdrawals
        WHERE status = 'pending'
    """)
    pending_withdrawals = cur.fetchone()[0]

    cur.execute("""
        SELECT
            COALESCE(SUM(deposit_balance), 0),
            COALESCE(SUM(income_balance), 0)
        FROM users
    """)
    balances = cur.fetchone()

    conn.close()

    text = (
        "📊 Admin Overview\n\n"
        f"👥 Users: {users}\n"
        f"🏦 Pending Deposits: {pending_deposits}\n"
        f"💸 Pending Withdrawals: {pending_withdrawals}\n"
        f"💳 Total Deposit Balance: ₦{balances[0]:,.2f}\n"
        f"💵 Total Income Balance: ₦{balances[1]:,.2f}"
    )

    await query.edit_message_text(
        text,
        reply_markup=admin_keyboard()
    )

async def admin_users(query):
    conn = db()
    cur = conn.cursor()

    cur.execute("""
        SELECT id, telegram_id, username, deposit_balance, income_balance
        FROM users
        ORDER BY id DESC
        LIMIT 20
    """)
    users = cur.fetchall()
    conn.close()

    if not users:
        text = "👥 Users\n\nNo users found."
    else:
        text = "👥 Recent Users\n\n"

        for user in users:
            text += (
                f"ID: {user[0]}\n"
                f"Telegram: {user[1]}\n"
                f"Username: @{user[2] if user[2] else 'N/A'}\n"
                f"Deposit: ₦{user[3]:,.2f}\n"
                f"Income: ₦{user[4]:,.2f}\n"
                "────────────\n"
            )

    await query.edit_message_text(
        text,
        reply_markup=admin_keyboard()
    )


async def admin_deposits(query):
    conn = db()
    cur = conn.cursor()

    cur.execute("""
        SELECT id, user_id, amount, method, status, created_at
        FROM deposits
        ORDER BY id DESC
        LIMIT 20
    """)
    deposits = cur.fetchall()
    conn.close()

    if not deposits:
        text = "💰 Deposits\n\nNo deposits found."
        keyboard = [
            [InlineKeyboardButton(
                "⬅️ Admin Menu",
                callback_data="admin"
            )]
        ]
    else:
        text = "💰 Recent Deposits\n\n"
        keyboard = []

        for deposit in deposits:
            deposit_id = deposit[0]
            status = deposit[4]

            text += (
                f"ID: {deposit_id}\n"
                f"User: {deposit[1]}\n"
                f"Amount: ₦{deposit[2]:,.2f}\n"
                f"Method: {deposit[3]}\n"
                f"Status: {status}\n"
                f"Date: {deposit[5]}\n"
                "────────────\n"
            )

            if status == "pending":
                keyboard.append([
                    InlineKeyboardButton(
                        "✅ Approve",
                        callback_data=f"approve_dep_{deposit_id}"
                    ),
                    InlineKeyboardButton(
                        "❌ Reject",
                        callback_data=f"reject_dep_{deposit_id}"
                    )
                ])

        keyboard.append([
            InlineKeyboardButton(
                "⬅️ Admin Menu",
                callback_data="admin"
            )
        ])

    await query.edit_message_text(
        text,
        reply_markup=InlineKeyboardMarkup(keyboard)
    )

async def admin_withdrawals(query):
    conn = db()
