async def admin_command(update, context):
    if update.effective_user.id != ADMIN_ID:
        await update.message.reply_text("Access denied.")
        return

    await update.message.reply_text(
        "🛠 AuraVest Admin Dashboard",
        reply_markup=admin_keyboard()
    )


async def manual_amount_start(query, context):
    context.user_data["awaiting_manual_amount"] = True

    await query.edit_message_text(
        "💵 Enter the exact amount you paid.\n\n"
        "Example: 5000"
    )

async def clear_user_prompt(context):
    message_id = context.user_data.pop("prompt_message_id", None)
    chat_id = context.user_data.pop("prompt_chat_id", None)

    if message_id and chat_id:
        try:
            await context.bot.delete_message(
                chat_id=chat_id,
                message_id=message_id
            )
        except Exception:
            pass

async def callback_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query

    await clear_user_prompt(context)

    try:
        await query.answer()
    except Exception:
        pass

    data = query.data

    if data == "home":
        await query.edit_message_text(
            "🌟 AuraVest\n\nChoose an option:",
            reply_markup=main_menu()
        )
        return

    if data == "balance":
        await show_balance(query)
        return

    if data == "deposit":
        await show_deposit_menu(query)
        return

    if data == "automatic_deposit":
        context.user_data["awaiting_automatic_amount"] = True
        await automatic_deposit(query, context)
        return

    if data == "manual_deposit":
        await manual_deposit(query)
        return

    if data == "manual_amount":
        await manual_amount_start(query, context)
        return

    if data == "plans":
        await show_plans(query)
        return

    if data == "orders":
        await show_orders(query)
        return

    if data.startswith("plan_"):
        amount = int(data.split("_")[1])
        await buy_plan(query, amount)
        return

    if data == "refer":
        await show_referral(query)
        return

    if data == "daily_checkin":
        await daily_checkin(query)
        return

    if data == "withdraw":
        context.user_data["awaiting_withdrawal_amount"] = True
        await withdrawal_start(query)
        return

    if data == "admin_overview":
        await admin_overview(query)
        return

    if data == "admin_deposits":
        await admin_deposits(query)
        return

    if data == "admin_withdrawals":
        await admin_withdrawals(query)
        return

    if data == "admin_users":
        await admin_users(query)
        return

    if data.startswith("approve_dep_"):
        await approve_deposit(query, int(data.split("_")[-1]))
        return

    if data.startswith("reject_dep_"):
        await reject_deposit(query, int(data.split("_")[-1]))
        return

    if data.startswith("approve_wd_"):
        await approve_withdrawal(query, int(data.split("_")[-1]))
        return

    if data.startswith("reject_wd_"):
        await reject_withdrawal(query, int(data.split("_")[-1]))
        return


async def handle_manual_photo(update, context):
    user_id = update.effective_user.id

    amount = context.user_data.get("manual_deposit_amount")

    if not amount:
        await update.message.reply_text(
            "❌ No pending manual deposit found.\n\n"
            "Please start the deposit process again."
        )
        return

    photo = update.message.photo[-1]
    file_id = photo.file_id

    conn = db()
    cur = conn.cursor()

    cur.execute("""
        INSERT INTO deposits
        (user_id, amount, method, screenshot_file_id, status, created_at)
        VALUES (?, ?, ?, ?, ?, ?)
    """, (
        user_id,
        amount,
        "manual",
        file_id,
        "pending",
        datetime.now().isoformat()
    ))

    conn.commit()
    conn.close()

    context.user_data.pop("manual_deposit_amount", None)

    await update.message.reply_text(
        f"✅ Deposit submitted successfully!\n\n"
        f"Amount: ₦{amount:,.2f}\n"
        f"Status: Pending admin approval.\n\n"
        f"Your deposit balance will be updated after verification."
    )

async def text_handler(update, context):
    if not update.message:
        return

    text = update.message.text.strip()

    # Manual deposit amount
    if context.user_data.get("awaiting_manual_amount"):
        try:
            amount = float(text.replace(",", ""))
        except ValueError:
            await update.message.reply_text(
                "❌ Enter a valid amount.\n\n"
                "Example: 5000"
            )
            return

        if amount <= 0:
            await update.message.reply_text(
                "❌ Amount must be greater than zero."
            )
            return

        context.user_data["manual_deposit_amount"] = amount
        context.user_data.pop("awaiting_manual_amount", None)

        await update.message.reply_text(
            f"💵 Amount: ₦{amount:,.2f}\n\n"
            "📸 Now send your payment screenshot/photo."
        )
        return

    # Withdrawal amount
    if context.user_data.get("awaiting_withdrawal_amount"):
        await withdrawal_amount(update, context)
        return

    # Automatic deposit amount
    if context.user_data.get("awaiting_automatic_amount"):
        await automatic_amount(update, context)
        return
def main():
    init_db()

    app = (
        Application.builder()
        .token(TOKEN)
        .connect_timeout(30)
        .read_timeout(30)
        .write_timeout(30)
        .pool_timeout(30)
        .build()
)
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("admin", admin_command))

    app.add_handler(CallbackQueryHandler(callback_handler))

    app.add_handler(
        MessageHandler(filters.PHOTO, handle_manual_photo)
    )

    app.add_handler(
        MessageHandler(filters.TEXT & ~filters.COMMAND, text_handler)
    )

    print("AuraVest bot is running...")

    app.run_polling()


if __name__ == "__main__":
    main()
