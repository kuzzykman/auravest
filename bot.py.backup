async def buy_plan(query, amount):

    user = get_user(query.from_user.id)

    if not user:
        return

    balance = user[3]

    if balance < amount:

        await query.edit_message_text(
            f"❌ Insufficient Deposit Balance.\n\n"
            f"Plan: ₦{amount:,.2f}\n"
            f"Your Balance: ₦{balance:,.2f}",
            reply_markup=InlineKeyboardMarkup([
                [
                    InlineKeyboardButton(
                        "💳 Deposit",
                        callback_data="deposit"
                    )
                ],
                [
                    InlineKeyboardButton(
                        "⬅️ Back",
                        callback_data="plans"
                    )
                ],
            ])
        )

        return

    conn = db()
    cur = conn.cursor()

    cur.execute("""
        UPDATE users
        SET deposit_balance = deposit_balance - ?
        WHERE user_id = ?
    """, (amount, query.from_user.id))

    daily_income = amount * 0.30
    start_date = datetime.now()
    expiry_date = start_date + timedelta(days=365)

    cur.execute("""
        INSERT INTO plan_purchases
        (
            user_id,
            amount,
            created_at,
            daily_income,
            last_income,
            expires_at,
            total_earned
        )
        VALUES (?, ?, ?, ?, ?, ?, ?)
    """, (
        query.from_user.id,
        amount,
        start_date.isoformat(),
        daily_income,
        start_date.isoformat(),
        expiry_date.isoformat(),
        0
    ))
    conn.close()

    await query.edit_message_text(
        f"✅ Plan Purchase Successful\n\n"
        f"Plan Amount: ₦{amount:,.2f}\n\n"
        "Your plan purchase has been recorded.",
        reply_markup=InlineKeyboardMarkup([
            [
                InlineKeyboardButton(
                    "🏠 Main Menu",
                    callback_data="home"
                )
            ]
        ])
    )


