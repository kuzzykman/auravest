DB = "auravest.db"

def db():
    return sqlite3.connect(DB)


def init_db():
    conn = db()
    cur = conn.cursor()

    cur.execute("""
        CREATE TABLE IF NOT EXISTS plan_purchases (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            amount REAL,
            created_at TEXT,
            daily_income REAL DEFAULT 0,
            last_income TEXT,
            expires_at TEXT,
            total_earned REAL DEFAULT 0
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS withdrawals (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            amount REAL,
            fee REAL,
            net_amount REAL,
            bank_name TEXT,
            account_number TEXT,
            account_name TEXT,
            status TEXT,
            created_at TEXT
        )
    """)

    # Add welcome bonus and daily check-in fields
    cur.execute("PRAGMA table_info(users)")
    columns = [row[1] for row in cur.fetchall()]

    if "welcome_bonus_claimed" not in columns:
        cur.execute("""
            ALTER TABLE users
            ADD COLUMN welcome_bonus_claimed INTEGER DEFAULT 0
        """)

    if "last_checkin" not in columns:
        cur.execute("""
            ALTER TABLE users
            ADD COLUMN last_checkin TEXT
        """)

    conn.commit()

    conn.commit()
    conn.close()

def db():
    return sqlite3.connect(DB)


def setup_database():
    conn = db()
    cur = conn.cursor()

    cur.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            first_name TEXT,
            deposit_balance REAL DEFAULT 0,
            income_balance REAL DEFAULT 0,
            referrer_id INTEGER,
            created_at TEXT
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS transactions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            tx_ref TEXT,
            amount REAL,
            type TEXT,
            status TEXT,
            created_at TEXT
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS deposits (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            amount REAL,
            method TEXT,
            screenshot_file_id TEXT,
            status TEXT DEFAULT 'pending',
            created_at TEXT
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS plan_purchases (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            amount REAL,
            created_at TEXT,
            daily_income REAL DEFAULT 0,
            last_income TEXT,
            expires_at TEXT,
            total_earned REAL DEFAULT 0
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS withdrawals (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            amount REAL,
            fee REAL,
            net_amount REAL,
            bank_name TEXT,
            account_number TEXT,
            account_name TEXT,
            status TEXT DEFAULT 'pending',
            created_at TEXT
        )
    """)

    conn.commit()
    conn.close()


# =========================================================
# USER FUNCTIONS
# =========================================================

def create_user(user, referrer_id=None):
    conn = db()
    cur = conn.cursor()

    cur.execute(
        "SELECT user_id FROM users WHERE user_id = ?",
        (user.id,)
    )

    exists = cur.fetchone()

    if not exists:
        cur.execute("""
            INSERT INTO users
            (
                user_id,
                username,
                first_name,
                income_balance,
                referrer_id,
                created_at,
                welcome_bonus_claimed
            )
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (
            user.id,
            user.username or "",
            user.first_name or "",
            400,
            referrer_id,
            datetime.now().isoformat(),
            1
        ))

    conn.commit()
    conn.close()

def get_user(user_id):
    conn = db()
    cur = conn.cursor()

    cur.execute("""
        SELECT user_id, username, first_name,
               deposit_balance, income_balance, referrer_id
        FROM users
        WHERE user_id = ?
    """, (user_id,))

    row = cur.fetchone()
    conn.close()

    return row

async def daily_checkin(query):
    user_id = query.from_user.id
    user = get_user(user_id)

    if not user:
        await query.answer("Account not found.", show_alert=True)
        return

    conn = db()
    cur = conn.cursor()

    cur.execute(
        "SELECT last_checkin FROM users WHERE user_id = ?",
        (user_id,)
    )
    row = cur.fetchone()

    last_checkin = row[0] if row else None

    if last_checkin:
        last_time = datetime.fromisoformat(last_checkin)
        elapsed = datetime.now() - last_time

        if elapsed < timedelta(hours=24):
            remaining = timedelta(hours=24) - elapsed
            hours = int(remaining.total_seconds() // 3600)
            minutes = int((remaining.total_seconds() % 3600) // 60)

            conn.close()

            await query.answer(
                f"⏳ Come back in {hours}h {minutes}m.",
                show_alert=True
            )
            return

    reward = random.randint(60, 100)

    cur.execute("""
        UPDATE users
        SET income_balance = income_balance + ?,
            last_checkin = ?
        WHERE user_id = ?
    """, (
        reward,
        datetime.now().isoformat(),
        user_id
    ))

    conn.commit()
    conn.close()

    await query.edit_message_text(
        f"🎁 Daily Check-in\n\n"
        f"Congratulations! 🎉\n\n"
        f"You received ₦{reward:,.2f}\n"
        f"The reward has been added to your Income Balance.\n\n"
        f"⏰ You can check in again after 24 hours.",
        reply_markup=InlineKeyboardMarkup([
            [
                InlineKeyboardButton(
                    "⬅️ Main Menu",
                    callback_data="home"
                )
            ]
        ])
    )

def add_deposit_balance(user_id, amount):
    conn = db()
    cur = conn.cursor()

    cur.execute("""
        UPDATE users
        SET deposit_balance = deposit_balance + ?
        WHERE user_id = ?
    """, (amount, user_id))

    conn.commit()
    conn.close()


def add_income_balance(user_id, amount):
    conn = db()
    cur = conn.cursor()

    cur.execute("""
        UPDATE users
        SET income_balance = income_balance + ?
        WHERE user_id = ?
    """, (amount, user_id))

    conn.commit()
    conn.close()


