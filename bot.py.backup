async def show_orders(query):
    user_id = query.from_user.id

    conn = db()
    cur = conn.cursor()

    cur.execute("""
        SELECT amount, daily_income, created_at,
               expires_at, total_earned
        FROM plan_purchases
        WHERE user_id = ?
        ORDER BY id DESC
    """, (user_id,))

    orders = cur.fetchall()
    conn.close()

    if not orders:
        await query.edit_message_text(
            "📦 My Orders\n\n"
            "You have not purchased any plan yet.",
            reply_markup=InlineKeyboardMarkup([
                [
                    InlineKeyboardButton(
                        "📦 View Plans",
                        callback_data="plans"
                    )
                ],
                [
                    InlineKeyboardButton(
                        "⬅️ Main Menu",
                        callback_data="home"
                    )
                ]
            ])
        )
        return

    message = "📦 MY ORDERS\n\n"

    for i, order in enumerate(orders, 1):
        amount, daily_income, created_at, expires_at, total_earned = order

        start_date = datetime.fromisoformat(created_at)
        expiry_date = datetime.fromisoformat(expires_at)

        remaining = expiry_date - datetime.now()

        if remaining.total_seconds() > 0:
            days = remaining.days
            hours = remaining.seconds // 3600
            time_remaining = f"{days} days, {hours} hours"
        else:
            time_remaining = "Expired"

        message += (
            f"📦 Order #{i}\n"
            f"💰 Plan: ₦{amount:,.2f}\n"
            f"💵 Daily Income: ₦{daily_income:,.2f}\n"
            f"📈 Total Earned: ₦{total_earned:,.2f}\n"
            f"📅 Started: {start_date.strftime('%d/%m/%Y')}\n"
            f"⏳ Time Remaining: {time_remaining}\n\n"
        )

    await query.edit_message_text(
        message,
        reply_markup=InlineKeyboardMarkup([
            [
                InlineKeyboardButton(
                    "⬅️ Main Menu",
                    callback_data="home"
                )
            ]
        ])
    )
