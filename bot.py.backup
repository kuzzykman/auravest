        reply_markup=InlineKeyboardMarkup(keyboard)
    )

async def approve_withdrawal(query, withdrawal_id):
    conn = db()
    cur = conn.cursor()

    cur.execute("""
        SELECT user_id, amount, status
        FROM withdrawals
        WHERE id = ?
    """, (withdrawal_id,))

    withdrawal = cur.fetchone()

    if not withdrawal:
        conn.close()
        await query.answer("Withdrawal not found.", show_alert=True)
        return

    user_id, amount, status = withdrawal

    if status != "pending":
        conn.close()
        await query.answer(f"Already {status}.", show_alert=True)
        return

    cur.execute("""
        UPDATE withdrawals
        SET status = 'approved'
        WHERE id = ?
    """, (withdrawal_id,))

    conn.commit()
    conn.close()

    await query.answer("Withdrawal approved.", show_alert=True)

    await query.edit_message_text(
        f"✅ Withdrawal Approved\n\n"
        f"ID: {withdrawal_id}\n"
        f"User: {user_id}\n"
        f"Amount: ₦{amount:,.2f}",
        reply_markup=admin_keyboard()
    )


async def reject_withdrawal(query, withdrawal_id):
    conn = db()
    cur = conn.cursor()

    cur.execute("""
        SELECT user_id, amount, status
        FROM withdrawals
        WHERE id = ?
    """, (withdrawal_id,))

    withdrawal = cur.fetchone()

    if not withdrawal:
        conn.close()
        await query.answer("Withdrawal not found.", show_alert=True)
        return

    user_id, amount, status = withdrawal

    if status != "pending":
        conn.close()
        await query.answer(f"Already {status}.", show_alert=True)
        return

    cur.execute("""
        UPDATE withdrawals
        SET status = 'rejected'
        WHERE id = ?
    """, (withdrawal_id,))

    cur.execute("""
        UPDATE users
        SET income_balance = income_balance + ?
        WHERE user_id = ?
    """, (amount, user_id))

    conn.commit()
    conn.close()

    await query.answer("Withdrawal rejected.", show_alert=True)

    await query.edit_message_text(
        f"❌ Withdrawal Rejected\n\n"
        f"ID: {withdrawal_id}\n"
        f"User: {user_id}\n"
        f"Amount refunded: ₦{amount:,.2f}",
        reply_markup=admin_keyboard()
    )

